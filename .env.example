# HubSpot Forms API (create the form in HubSpot, then paste IDs here)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID=
# Optional: subscription type ID for marketing consent in HubSpot
HUBSPOT_SUBSCRIPTION_TYPE_ID=

# Resend (sends lead notification emails to Calvin)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=calvinlyman@gmail.com
LEAD_FROM_EMAIL=leads@calvinlymanrealestate.com

# Allow accepted form submissions in local/dev without HubSpot/Resend
ALLOW_DEMO_LEADS=true
